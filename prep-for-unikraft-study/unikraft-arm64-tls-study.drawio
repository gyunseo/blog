                </mxCell>
                <mxCell id="i_cursor" value="writepos 커서 진행 방향 →" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontColor=#b85450;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="60" y="180" as="sourcePoint"/>
                        <mxPoint x="1140" y="180" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="i_step1" value="① memset(writepos, 0, 패딩1)&#xa;tls.c:238 (CLEAR_TBSS 옵션 시)&#xa;아무도 안 읽는 공간이지만 0으로" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="420" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_step2" value="② TCB 초기화 — 둘 중 하나&#xa;- libC 있음: ukarch_tls_tcb_init(writepos) 호출&#xa;  → lib-musl __uk_init_tls.c가 구현 (tls.c:246-247)&#xa;- libC 없음: memset 0 (tls.c:249)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="280" y="420" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_step3" value="③ memset(writepos, 0, 패딩2)&#xa;tls.c:259 — ABI 거리(tlsp+16=.tdata) 유지용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="600" y="420" width="250" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_step4" value="④ memcpy(writepos, _tls_start, tdata크기)&#xa;tls.c:267 — __thread 변수 초기값 복사" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="870" y="420" width="250" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_step5" value="⑤ memset(writepos, 0, tbss크기)&#xa;tls.c:274 — .tbss 0 클리어&#xa;(디버그 출력만 tdata_size 오타, tls.c:271-272)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="420" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i_note" value="핵심 관찰 3가지&#xa;1) 이 함수는 &#39;레이아웃 규칙(각 *_size 함수)&#39;을 그대로 실행에 옮기는 유일한 쓰기 코드 — 규칙과 실행이 어긋나면 중간 assert들이 즉시 잡아냄&#xa;2) 복사는 .tdata 한 곳뿐, 나머지는 전부 0 클리어 또는 libC 위임&#xa;3) 마지막 assert(tls.c:278-279)가 ukarch_tls_area_size()와 실제 쓴 바이트 수의 일치를 보증 → 크기 계산 함수들과 이 함수는 한 몸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="530" width="1080" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>