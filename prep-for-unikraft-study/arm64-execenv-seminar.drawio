<mxfile host="65bd71144e">
    <diagram id="when-why" name="01 언제 왜 호출되는가">
        <mxGraphModel dx="584" dy="696" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="w-title" value="execenv.S | 언제, 왜 호출되는가" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=30;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
                    <mxGeometry x="50" y="25" width="1500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="w-answer" value="&lt;b&gt;정확한 답&lt;/b&gt;: 저장된 완전한 CPU 문맥을 현재 CPU에 덮어쓰고 eret하는 non-returning loader다. deferred fault/signal에서는 원래 application 문맥 복귀에 쓰이지만, 모든 IRQ/trap의 공통 복귀 코드는 아니다.&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: arch/arm/arm64/execenv.S:11-20, 32-93; arch/arm/ctx.c:176-183; plat/xen/arm/entry64.S:602-635&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#374151;fillColor=#f9fafb;align=left;verticalAlign=middle;spacing=16;fontSize=18;fontColor=#111827;" parent="1" vertex="1">
                    <mxGeometry x="50" y="90" width="1500" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="w-normal-label" value="&lt;b&gt;일반 IRQ / synchronous trap&lt;/b&gt;&lt;br&gt;execenv.S를 호출하지 않는 경로&lt;br&gt;&lt;font color=&quot;#991b1b&quot;&gt;근거: plat/xen/arm/entry64.S:602-635&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#dc2626;fillColor=#fee2e2;align=left;verticalAlign=middle;spacing=12;fontSize=17;fontColor=#111827;" parent="1" vertex="1">
                    <mxGeometry x="50" y="225" width="275" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="w-n1" value="vector&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;entry64.S:572-596&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#6b7280;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="375" y="235" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="w-n2" value="trap_entry&lt;br&gt;register 저장&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;entry64.S:477-518&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#6b7280;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="580" y="225" width="180" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w-n3" value="C handler&lt;br&gt;반환&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;entry64.S:602-634&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#6b7280;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="815" y="235" width="160" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="w-n4" value="trap_exit&lt;br&gt;register 복원&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;entry64.S:520-561&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#6b7280;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="225" width="180" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w-n5" value="eret&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;entry64.S:607,616,625,634&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#dc2626;fillColor=#fff7ed;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1265" y="235" width="190" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="w-ne1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6b7280;endArrow=block;endFill=1;" parent="1" source="w-n1" target="w-n2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w-ne2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6b7280;endArrow=block;endFill=1;" parent="1" source="w-n2" target="w-n3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w-ne3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6b7280;endArrow=block;endFill=1;" parent="1" source="w-n3" target="w-n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w-ne4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#dc2626;endArrow=block;endFill=1;" parent="1" source="w-n4" target="w-n5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w-deferred-label" value="&lt;b&gt;deferred fault / signal&lt;/b&gt;&lt;br&gt;별도 stack으로 이동했기 때문에 execenv.S로 완전 문맥을 재적재&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;근거: system_error.c:22-64; arch/arm/ctx.c:176-218&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#16a34a;fillColor=#dcfce7;align=left;verticalAlign=middle;spacing=12;fontSize=17;fontColor=#111827;" parent="1" vertex="1">
                    <mxGeometry x="50" y="405" width="275" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="w-d1" value="fault event&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;system_error.c:69-108&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#0f766e;fillColor=#ccfbf1;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="355" y="425" width="155" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="w-d2" value="ctx_init_ehtrampo&lt;br&gt;execenv 저장&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;arch/arm/ctx.c:185-218&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#ea580c;fillColor=#ffedd5;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="550" y="415" width="190" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="w-d3" value="별도 stack에서&lt;br&gt;signal 처리 후 return&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;signal/deliver.c:372-424&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#d97706;fillColor=#fef3c7;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="780" y="415" width="210" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="w-d4" value="ehtrampo_dispatcher&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;arch/arm/ctx.c:176-183&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#0f766e;fillColor=#ccfbf1;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="425" width="190" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="w-d5" value="ukarch_execenv_load&lt;br&gt;전체 문맥 복원&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;execenv.S:20-91&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=3;strokeColor=#16a34a;fillColor=#dcfce7;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="415" width="230" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="w-de1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0f766e;endArrow=block;endFill=1;" parent="1" source="w-d1" target="w-d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w-de2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0f766e;endArrow=block;endFill=1;" parent="1" source="w-d2" target="w-d3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w-de3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0f766e;endArrow=block;endFill=1;" parent="1" source="w-d3" target="w-d4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w-de4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#16a34a;endArrow=block;endFill=1;" parent="1" source="w-d4" target="w-d5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w-eret" value="eret -&gt; 저장된 ELR_EL1/SPSR_EL1 문맥&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;근거: arch/arm/arm64/execenv.S:59-66, 85-93&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=3;strokeColor=#16a34a;fillColor=#ecfdf5;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="575" width="365" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="w-de5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#16a34a;endArrow=block;endFill=1;" parent="1" source="w-d5" target="w-eret" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w-clone" value="&lt;b&gt;clone 자식 첫 실행&lt;/b&gt;&lt;br&gt;부모 snapshot 복사 -&gt; x0/SP/TLS patch -&gt; child ctx entry = ukarch_execenv_load&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: lib/posix-process/arch/arm64/clone.c:30-63&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#2563eb;fillColor=#dbeafe;align=left;verticalAlign=middle;spacing=14;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="50" y="705" width="710" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="w-execve" value="&lt;b&gt;execve 새 프로그램 첫 실행&lt;/b&gt;&lt;br&gt;새 stack/context 준비 -&gt; old stack 정리 -&gt; ukarch_execenv_load(new)&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: lib/posix-process/execve.c:22-64, 140-203&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#d97706;fillColor=#fef3c7;align=left;verticalAlign=middle;spacing=14;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="810" y="705" width="745" height="115" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="horizontal-layout" name="02 수평 메모리 레이아웃">
        <mxGraphModel dx="584" dy="696" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="l-title" value="ukarch_execenv | 낮은 주소에서 높은 주소로 보는 수평 layout" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=29;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
                    <mxGeometry x="50" y="25" width="1500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="l-note" value="Xen PAL은 REGS/ECTX를 native ARM64 layout에 위임하고 SYSCTX도 native format을 사용한다.&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: plat/xen/pal/include/uk/plat/pal/regs.h:13-21; ectx.h:10-23; sysctx.h:13-26&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#374151;fillColor=#f9fafb;align=left;verticalAlign=middle;spacing=14;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="50" y="90" width="1500" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="l-low" value="낮은 주소&lt;br&gt;execenv +0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=bottom;fontSize=16;fontStyle=1;fontColor=#374151;" parent="1" vertex="1">
                    <mxGeometry x="70" y="190" width="160" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="l-high" value="높은 주소&lt;br&gt;execenv +832" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=bottom;fontSize=16;fontStyle=1;fontColor=#374151;" parent="1" vertex="1">
                    <mxGeometry x="1370" y="190" width="160" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="l-regs" value="&lt;b&gt;REGS | 288B&lt;/b&gt;&lt;br&gt;offset 0..287&lt;br&gt;x0-x29, LR, ELR, SPSR, ESR, SP, pad&lt;br&gt;&lt;font color=&quot;#1e40af&quot;&gt;근거: native ARM64 regs.h:18-55, 63-113&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#2563eb;fillColor=#dbeafe;align=center;verticalAlign=middle;spacing=10;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="70" y="250" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="l-sys" value="&lt;b&gt;SYSCTX&lt;/b&gt;&lt;br&gt;16B&lt;br&gt;288..303&lt;br&gt;TPIDR_EL0&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;sysctx.h:14-41&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#16a34a;fillColor=#dcfce7;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="760" y="250" width="145" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="l-ectx" value="&lt;b&gt;ECTX | 520B&lt;/b&gt;&lt;br&gt;offset 304..823&lt;br&gt;q0-q31 512B + FPSR + FPCR&lt;br&gt;&lt;font color=&quot;#9a3412&quot;&gt;근거: native ARM64 ectx.h:19-51&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#ea580c;fillColor=#ffedd5;align=center;verticalAlign=middle;spacing=10;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="905" y="250" width="520" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="l-pad" value="&lt;b&gt;PAD&lt;/b&gt;&lt;br&gt;8B&lt;br&gt;824..831&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;ctx.h:63-83&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#6b7280;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1425" y="250" width="105" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="l-formula" value="&lt;b&gt;288 + 16 + 520 + 8 = 832B&lt;/b&gt;&lt;br&gt;field offset: REGS=0, SYSCTX=288, ECTX=304, PAD=824&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: include/uk/arch/ctx.h:63-89, 139-158&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#d97706;fillColor=#fef3c7;align=center;verticalAlign=middle;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="350" y="430" width="900" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="l-r0" value="x0..x17&lt;br&gt;0..143" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#2563eb;fillColor=#eff6ff;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="70" y="585" width="295" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-r1" value="x18,x19&lt;br&gt;144..159" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#7c3aed;fillColor=#f5f3ff;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="365" y="585" width="135" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-r2" value="x20..x29&lt;br&gt;160..239" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#2563eb;fillColor=#eff6ff;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="500" y="585" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-r3" value="LR&lt;br&gt;240" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#0f766e;fillColor=#ccfbf1;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="730" y="585" width="100" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-r4" value="ELR&lt;br&gt;248" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#16a34a;fillColor=#dcfce7;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="585" width="110" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-r5" value="SPSR&lt;br&gt;256" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#16a34a;fillColor=#dcfce7;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="940" y="585" width="115" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-r6" value="ESR&lt;br&gt;264" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#d97706;fillColor=#fef3c7;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="1055" y="585" width="105" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-r7" value="SP&lt;br&gt;272" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#dc2626;fillColor=#fee2e2;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="585" width="110" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-r8" value="pad&lt;br&gt;280..287" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#6b7280;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="585" width="120" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="l-reg-caption" value="REGS 288B 확대 | ELR/SPSR는 eret 목적지와 상태, SP는 마지막에 실제 CPU sp로 적재된다.&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: native ARM64 regs.h:18-60; arch/arm/arm64/execenv.S:59-66, 85-93&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#2563eb;fillColor=#ffffff;align=left;verticalAlign=middle;spacing=14;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="70" y="715" width="1320" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="l-key" value="&lt;b&gt;주소 계산 3개만 기억&lt;/b&gt;&lt;br&gt;x19=base | base+304=ECTX | base+288=SYSCTX | sp=base로 REGS를 읽은 뒤 [base+272]를 target SP로 사용&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: execenv.S:30, 37-38, 44-57, 85-91&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#374151;fillColor=#f9fafb;align=center;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="300" y="815" width="1000" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="instruction-trace" name="03 어셈블리 실행 추적">
        <mxGraphModel dx="584" dy="696" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t-title" value="execenv.S | instruction이 실행될 때 수평 memory bar에서 무슨 일이 일어나는가" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=28;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
                    <mxGeometry x="50" y="20" width="1500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="t-note" value="각 행의 진한 색이 현재 instruction이 주소로 사용하거나 복원하는 영역이다. 공통 layout 근거: include/uk/arch/ctx.h:63-89, 139-158" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#374151;fillColor=#f9fafb;align=left;verticalAlign=middle;spacing=12;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="50" y="78" width="1500" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="t-i1" value="&lt;b&gt;1 | IRQ mask, base 보존&lt;/b&gt;&lt;br&gt;msr daifset,#2&lt;br&gt;mov x19,x0&lt;br&gt;x0=x19=execenv base&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: execenv.S:20-30&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#2563eb;fillColor=#dbeafe;align=left;verticalAlign=middle;spacing=12;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="50" y="155" width="390" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="t1-r" value="REGS&lt;br&gt;0..287&lt;br&gt;&lt;b&gt;x0/x19 -&gt; base&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#2563eb;fillColor=#bfdbfe;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="500" y="165" width="440" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t1-s" value="SYS&lt;br&gt;288..303" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="940" y="165" width="120" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t1-e" value="ECTX&lt;br&gt;304..823" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="165" width="390" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t1-p" value="PAD" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="165" width="80" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t-i2" value="&lt;b&gt;2 | ECTX 복원&lt;/b&gt;&lt;br&gt;add x0,base,#304&lt;br&gt;bl ECTX_LOAD&lt;br&gt;q0-q31/FPSR/FPCR 복원&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: execenv.S:32-38&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#ea580c;fillColor=#ffedd5;align=left;verticalAlign=middle;spacing=12;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="50" y="280" width="390" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="t2-r" value="REGS&lt;br&gt;0..287" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="500" y="290" width="440" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t2-s" value="SYS&lt;br&gt;288..303" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="940" y="290" width="120" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t2-e" value="&lt;b&gt;ECTX 304..823&lt;/b&gt;&lt;br&gt;x0 -&gt; base+304&lt;br&gt;CPU FP/NEON으로 load" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#ea580c;fillColor=#fed7aa;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="290" width="390" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t2-p" value="PAD" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="290" width="80" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t-i3" value="&lt;b&gt;3 | SYSCTX 복원&lt;/b&gt;&lt;br&gt;mov x0,x19&lt;br&gt;add x0,base,#288&lt;br&gt;bl SYSCTX_LOAD&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: execenv.S:40-51&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#16a34a;fillColor=#dcfce7;align=left;verticalAlign=middle;spacing=12;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="50" y="405" width="390" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="t3-r" value="REGS&lt;br&gt;0..287" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="500" y="415" width="440" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t3-s" value="&lt;b&gt;SYS&lt;/b&gt;&lt;br&gt;288..303&lt;br&gt;x0 -&gt; base+288&lt;br&gt;TPIDR_EL0 load" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#16a34a;fillColor=#bbf7d0;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="940" y="415" width="120" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t3-e" value="ECTX&lt;br&gt;304..823&lt;br&gt;복원 완료" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#ea580c;fillColor=#fff7ed;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="415" width="390" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t3-p" value="PAD" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="415" width="80" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t-i4" value="&lt;b&gt;4 | exception state&lt;/b&gt;&lt;br&gt;mov sp,x19&lt;br&gt;[256/264] -&gt; SPSR/ESR&lt;br&gt;[240/248] -&gt; LR/ELR&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: execenv.S:53-66&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#2563eb;fillColor=#dbeafe;align=left;verticalAlign=middle;spacing=12;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="50" y="530" width="390" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="t4-r" value="&lt;b&gt;REGS를 임시 stack으로 사용&lt;/b&gt;&lt;br&gt;sp=base | LR@240 | ELR@248 | SPSR@256 | ESR@264&lt;br&gt;ELR_EL1/SPSR_EL1 system register에 기록" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#2563eb;fillColor=#bfdbfe;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="500" y="540" width="440" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t4-s" value="SYS&lt;br&gt;복원 완료" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#16a34a;fillColor=#f0fdf4;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="940" y="540" width="120" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t4-e" value="ECTX&lt;br&gt;복원 완료" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#ea580c;fillColor=#fff7ed;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="540" width="390" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t4-p" value="PAD" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="540" width="80" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t-i5" value="&lt;b&gt;5 | GPR 복원&lt;/b&gt;&lt;br&gt;ldp x28..x0&lt;br&gt;x18/x19 slot만 보류&lt;br&gt;helper call은 이제 없음&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: execenv.S:68-83&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#7c3aed;fillColor=#f5f3ff;align=left;verticalAlign=middle;spacing=12;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="50" y="655" width="390" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="t5-r" value="&lt;b&gt;x0..x17, x20..x30 복원&lt;/b&gt;&lt;br&gt;x18/x19는 base와 target SP 처리 때문에 마지막까지 보류&lt;br&gt;&lt;font color=&quot;#4c1d95&quot;&gt;x18/x19 slot = offset 144/152&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#7c3aed;fillColor=#ede9fe;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="500" y="665" width="440" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t5-s" value="SYS&lt;br&gt;복원 완료" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#16a34a;fillColor=#f0fdf4;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="940" y="665" width="120" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t5-e" value="ECTX&lt;br&gt;복원 완료" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#ea580c;fillColor=#fff7ed;align=center;verticalAlign=middle;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="665" width="390" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t5-p" value="PAD" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#9ca3af;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="665" width="80" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t-i6" value="&lt;b&gt;6 | target SP, eret&lt;/b&gt;&lt;br&gt;[base+272] -&gt; x18 -&gt; sp&lt;br&gt;[base+144] -&gt; x18/x19&lt;br&gt;eret&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: execenv.S:85-93&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=3;strokeColor=#16a34a;fillColor=#dcfce7;align=left;verticalAlign=middle;spacing=12;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="50" y="780" width="390" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="t6-r" value="&lt;b&gt;REGS +272의 target SP를 CPU sp에 기록&lt;/b&gt;&lt;br&gt;base+144에서 x18/x19까지 복원 완료&lt;br&gt;ELR_EL1 + SPSR_EL1을 사용해 eret" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#16a34a;fillColor=#bbf7d0;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="790" width="440" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t6-final" value="현재 함수/stack은 폐기&lt;br&gt;&lt;b&gt;저장된 문맥으로 실행 재개&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;근거: execenv.S:85-93; ctx.h:518-527&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=3;strokeColor=#16a34a;fillColor=#ecfdf5;align=center;verticalAlign=middle;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="785" width="490" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="t6-edge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#16a34a;endArrow=block;endFill=1;" parent="1" source="t6-r" target="t6-final" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="xen-audit" name="04 Xen frame 점검">
        <mxGraphModel dx="584" dy="696" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="a-title" value="현재 HEAD의 Xen trap-frame 점검 | 10분 발표에서는 제외 권장" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=29;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
                    <mxGeometry x="50" y="25" width="1500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="a-warning" value="consumer인 execenv.S는 native/PAL 288B layout을 읽지만 producer인 Xen trap_entry는 다른 272B layout을 만든다. Xen runtime에 적용하기 전에 양쪽 계약 정합성을 확인해야 한다.&lt;br&gt;&lt;font color=&quot;#991b1b&quot;&gt;근거: execenv.S:59-91; xen/arm/entry64.S:477-518; native ARM64 regs.h:48-55&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=3;strokeColor=#dc2626;fillColor=#fee2e2;align=left;verticalAlign=middle;spacing=16;fontSize=18;fontColor=#7f1d1d;" parent="1" vertex="1">
                    <mxGeometry x="50" y="95" width="1500" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-exp-title" value="&lt;b&gt;loader / PAL 기대: 288B&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1e40af&quot;&gt;근거: xen PAL regs.h:13-21; native ARM64 regs.h:48-55&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#2563eb;fillColor=#dbeafe;align=center;verticalAlign=middle;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="70" y="240" width="690" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a-e0" value="x0..x29&lt;br&gt;0..239" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#2563eb;fillColor=#eff6ff;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="70" y="355" width="220" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-e1" value="LR&lt;br&gt;240" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#2563eb;fillColor=#dbeafe;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="290" y="355" width="80" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-e2" value="ELR&lt;br&gt;248" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#16a34a;fillColor=#dcfce7;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="370" y="355" width="90" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-e3" value="SPSR&lt;br&gt;256" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#16a34a;fillColor=#dcfce7;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="460" y="355" width="95" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-e4" value="ESR&lt;br&gt;264" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#d97706;fillColor=#fef3c7;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="555" y="355" width="80" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-e5" value="SP&lt;br&gt;272" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#dc2626;fillColor=#fee2e2;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="635" y="355" width="75" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-e6" value="pad&lt;br&gt;280" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#6b7280;fillColor=#f3f4f6;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="710" y="355" width="50" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-act-title" value="&lt;b&gt;현재 Xen trap_entry 저장: 272B&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#991b1b&quot;&gt;근거: plat/xen/arm/entry64.S:477-518&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#dc2626;fillColor=#fee2e2;align=center;verticalAlign=middle;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="840" y="240" width="690" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a-a0" value="x0..x29&lt;br&gt;0..239" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#dc2626;fillColor=#fff7ed;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="840" y="355" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-a1" value="LR&lt;br&gt;240" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#dc2626;fillColor=#fecaca;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="355" width="100" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-a2" value="SP&lt;br&gt;248&lt;br&gt;&lt;b&gt;≠ ELR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#dc2626;fillColor=#fecaca;align=center;verticalAlign=middle;fontSize=15;fontColor=#7f1d1d;" parent="1" vertex="1">
                    <mxGeometry x="1210" y="355" width="105" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-a3" value="ELR&lt;br&gt;256&lt;br&gt;&lt;b&gt;≠ SPSR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#dc2626;fillColor=#fecaca;align=center;verticalAlign=middle;fontSize=15;fontColor=#7f1d1d;" parent="1" vertex="1">
                    <mxGeometry x="1315" y="355" width="110" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-a4" value="SPSR&lt;br&gt;264&lt;br&gt;&lt;b&gt;≠ ESR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#dc2626;fillColor=#fecaca;align=center;verticalAlign=middle;fontSize=15;fontColor=#7f1d1d;" parent="1" vertex="1">
                    <mxGeometry x="1425" y="355" width="105" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a-effect" value="&lt;b&gt;execenv.S가 실제로 읽는 값&lt;/b&gt;&lt;br&gt;[248] -&gt; ELR_EL1, [256] -&gt; SPSR_EL1, [264] -&gt; ESR_EL1, [272] -&gt; target SP. 현재 Xen frame을 그대로 주면 각 slot의 의미가 맞지 않고 [272]는 frame 밖이다.&lt;br&gt;&lt;font color=&quot;#991b1b&quot;&gt;근거: arch/arm/arm64/execenv.S:59-66, 85-91&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#dc2626;fillColor=#fff7ed;align=left;verticalAlign=middle;spacing=14;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="70" y="510" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="a-arg" value="&lt;b&gt;handler 인자도 점검 필요&lt;/b&gt;&lt;br&gt;native error handler는 (regs, far)와 regs+264의 ESR을 사용한다. Xen vector는 x0=sp만 설정하지만 KVM은 x1=far_el1까지 설정한다.&lt;br&gt;&lt;font color=&quot;#991b1b&quot;&gt;근거: native/arch/arm64/except.c:193-214; xen/arm/entry64.S:602-625; kvm/arm/exceptions.S:275-280&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#dc2626;fillColor=#fff7ed;align=left;verticalAlign=middle;spacing=14;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="840" y="510" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="a-next" value="&lt;b&gt;팀 후속 검증&lt;/b&gt;&lt;br&gt;1. Xen producer가 288B native layout을 생성하는지 확인&lt;br&gt;2. ESR/SP slot과 FAR x1 전달 확인&lt;br&gt;3. syscall adapter가 REGS 뒤 SYSCTX/ECTX 공간을 사용할 수 있는지 확인&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;근거: ctx.h:85-89; syscall_handler.c:20-35; KVM exceptions.S:123-191&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;strokeWidth=2;strokeColor=#d97706;fillColor=#fef3c7;align=left;verticalAlign=middle;spacing=16;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="250" y="720" width="1100" height="140" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>