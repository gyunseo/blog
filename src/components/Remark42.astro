---
// src/components/Remark42.astro
// 이 컴포넌트는 Remark42를 렌더링하고 동적 테마 변경을 처리합니다.
---

<div id="remark42" class="remark42"></div>

<style>
  /* 댓글 로딩 전 최소 높이를 지정하여 레이아웃 깨짐(CLS) 방지 */
  .remark42 {
    min-height: 200px;
  }
</style>

<script is:inline>
  var remark_config = {
    // ✅ 이전에 설정한 Remark42 서버 주소
    host: "https://comments.gyunseo.com",

    // ✅ docker-compose.yml의 SITE 환경변수 값
    site_id: "gyunseo-com",

    // 페이지 로딩 시 현재 블로그 테마(light/dark)를 확인하여 적용
    theme: localStorage.getItem("theme") || "light",

    // 한국어 UI로 설정
    locale: "ko",
  };
</script>

<script is:inline>
  !(function (e, n) {
    for (var o = 0; o < e.length; o++) {
      var r = n.createElement("script"),
        c = ".js",
        d = n.head || n.body;
      ("noModule" in r ? ((r.type = "module"), (c = ".mjs")) : (r.async = !0),
        (r.defer = !0),
        (r.src = remark_config.host + "/web/" + e[o] + c),
        d.appendChild(r));
    }
  })(["embed"], document);
</script>

<script is:inline>
  function changeRemark42Theme(theme) {
    // window.REMARK42 객체가 로드되었는지 확인 후 테마 변경 함수 호출
    if (window.REMARK42) {
      window.REMARK42.changeTheme(theme);
    }
  }

  // <html> 태그의 class 변경을 감지하여 테마 변경을 처리 (AstroPaper 방식)
  const observer = new MutationObserver(mutations => {
    mutations.forEach(mutation => {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "class"
      ) {
        const newTheme = document.documentElement.classList.contains("dark")
          ? "dark"
          : "light";
        changeRemark42Theme(newTheme);
      }
    });
  });

  observer.observe(document.documentElement, { attributes: true });

  // 페이지가 완전히 로드된 후에도 테마를 한 번 더 동기화
  window.addEventListener("load", () => {
    const currentTheme = localStorage.getItem("theme") || "light";
    changeRemark42Theme(currentTheme);
  });

  // Remark42 인스턴스 관리 변수
  let remark42Instance = null;

  function initRemark42() {
    const remark42Container = document.getElementById("remark42");
    if (!remark42Container) return;

    if (window.REMARK42) {
      // 기존 인스턴스가 있다면 제거
      if (remark42Instance) {
        try {
          remark42Instance.destroy();
        } catch (e) {
          console.log("Failed to destroy previous Remark42 instance:", e);
        }
      }

      // 새 인스턴스 생성
      remark42Instance = window.REMARK42.createInstance({
        node: remark42Container,
        ...remark_config,
      });
    }
  }

  // 페이지 로드 시 초기화
  if (window.REMARK42) {
    initRemark42();
  } else {
    window.addEventListener("REMARK42::ready", () => {
      initRemark42();
    });
  }

  // Astro View Transitions 지원: 댓글을 다시 렌더링
  document.addEventListener("astro:after-swap", () => {
    setTimeout(() => {
      initRemark42();
    }, 200);
  });
</script>
